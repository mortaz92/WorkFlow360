# --- Database ---
DATABASE_URL=postgresql://workflow360:workflow360@localhost:5432/workflow360

# --- Backend ---
PORT=4000
NODE_ENV=development
# Genera con: openssl rand -base64 32  (oppure: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Il valore qui sotto è solo un ESEMPIO della lunghezza attesa — non usarlo, generane uno tuo.
JWT_ACCESS_SECRET=REPLACE_ME_WITH_YOUR_OWN_RANDOM_32_BYTE_BASE64_SECRET_0000
JWT_REFRESH_SECRET=REPLACE_ME_WITH_YOUR_OWN_RANDOM_32_BYTE_BASE64_SECRET_1111
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Origini ammesse per CORS, separate da virgola. In produzione va impostata sul
# dominio reale del frontend deployato, mai lasciata permissiva.
# IN PRODUZIONE (Render): NON lasciare localhost. Va scritto l'URL vero del sito
# frontend, per esempio https://workflow360-web.onrender.com — senza schema/porta
# sbagliati e senza barra finale, altrimenti il browser blocca ogni chiamata all'API.
CORS_ORIGINS=http://localhost:5173

# --- Recupero password (facoltativo: senza RESEND_API_KEY il backend si avvia
# comunque, semplicemente non spedisce l'email — utile in locale/test) ---
# Crea un account su https://resend.com e incolla qui la tua API key. ATTENZIONE:
# senza un dominio verificato su Resend, il mittente di prova consegna solo
# all'indirizzo email del TITOLARE dell'account Resend, non ai tuoi dipendenti.
RESEND_API_KEY=
MAIL_FROM=WorkFlow360 <onboarding@resend.dev>
# Base per il link nell'email di reset: in produzione deve essere l'URL reale del
# frontend deployato (mai ricavato automaticamente, va scritto qui a mano).
# IN PRODUZIONE (Render): stesso URL usato in CORS_ORIGINS, es.
# https://workflow360-web.onrender.com — se resta su localhost, il link che arriva
# nell'email di recupero password non si apre da nessun telefono.
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_IN=1h

# --- Rapportino firmato dal cliente (commesse a consuntivo) ---
# Quanto resta valido il link con cui il cliente firma il rapportino giornaliero.
# Molto più corto del reset password: il cliente firma sul telefono/tablet dell'operaio
# che ha davanti, entro pochi minuti dalla creazione. Allungarlo significa lasciare in
# circolazione più a lungo un link che permette di firmare ore a chiunque lo intercetti.
RAPPORTINO_SIGN_EXPIRES_IN=15m

# Fuso orario del processo backend: senza, Render gira in UTC e le ore dei cantieri si
# leggerebbero spostate di 1-2h. In locale di solito coincide già col fuso del sistema.
TZ=Europe/Rome

# --- Frontend ---
# ATTENZIONE, verificato con una build reale: questa riga NON viene letta da Vite se
# lasciata attiva qui nella RADICE del monorepo — Vite cerca il .env dentro
# packages/frontend. Resta commentata apposta: in sviluppo non serve (senza valore il
# frontend usa il percorso relativo /api/v1 e il proxy di Vite lo gira su localhost:4000,
# v. packages/frontend/vite.config.ts) e valorizzarla qui darebbe l'illusione di un
# effetto che non c'è.
# IN PRODUZIONE (Render): va impostata tra le variabili del SITO STATICO (non qui), con
# l'URL vero del backend COMPRESO di /api/v1, es. https://workflow360-api.onrender.com/api/v1
# — lì Vite la legge dall'ambiente della build. Viene letta durante la build e non a
# runtime: se la cambi serve un nuovo deploy del frontend, perché il valore finisce
# dentro il pacchetto JavaScript.
# VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- Primo amministratore in produzione (solo per lo script bootstrap:admin) ---
# Servono SOLO quando si lancia una tantum `npm run bootstrap:admin --workspace=packages/backend`
# per creare la prima azienda e il primo admin su un database vuoto. Non metterle qui con
# valori veri: passale al comando al momento del lancio (vedi GUIDA-DEPLOY.md).
# BOOTSTRAP_COMPANY_NAME=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
